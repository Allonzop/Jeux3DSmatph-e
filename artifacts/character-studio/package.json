{
  "name": "@workspace/character-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Outil de creation de personnages procéduraux pour @workspace/3d-game",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --force && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "build:cli": "vite build --config vite.cli.config.ts",
    "studio": "vite build --config vite.cli.config.ts --logLevel error && node dist-cli/studio.mjs"
  },
  "dependencies": {
    "@react-three/drei": "catalog:",
    "@react-three/fiber": "catalog:",
    "@react-three/postprocessing": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "vite": "catalog:"
  }
}
