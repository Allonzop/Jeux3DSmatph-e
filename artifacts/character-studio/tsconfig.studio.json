{
  // Le code du studio — vérifié strictement, imports et paramètres inutilisés
  // compris.
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    // Le studio lit les personnages a leur source, dans le jeu.
    // Plus de copie, donc plus de KIT_VERSION a resynchroniser.
    "paths": {
      "@game/characters/*": ["../3d-game/src/game/characters/*"]
    }
  },
  "include": ["src/studio", "src/cli", "src/main.tsx", "src/App.tsx", "src/vite-env.d.ts"],
  "references": [{ "path": "./tsconfig.game-characters.json" }]
}
